# =====================================================================
# UPL Fire Safety Portal — Environment Variables (Example)
# =====================================================================
# Copy this file to backend/.env (backend) and frontend/.env (frontend)
# and adjust values as needed. Never commit real .env files.

# ---------- Backend ----------
# SQLite database file path (relative to backend/prisma/)
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development

# Session / Auth (fill in later phases)
SESSION_SECRET="please-change-this-in-production"
SESSION_COOKIE_NAME="upl.sid"
# Idle timeout — session lives this long without activity (sliding).
SESSION_MAX_AGE_MS=28800000
# Only bump lastSeenAt/expiresAt this often (avoids DB write amplification).
SESSION_REFRESH_INTERVAL_MS=300000
# Absolute cap on total session lifetime regardless of activity.
SESSION_ABSOLUTE_MAX_AGE_MS=2592000000

# Rate limits (per IP)
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60

# CORS — frontend origin allowed to call the API
CORS_ORIGIN="http://localhost:5173"

# File uploads
UPLOAD_DIR="./uploads"
UPLOAD_MAX_BYTES=10485760

# ---------- Frontend ----------
# Base URL for backend API (used by Axios)
VITE_API_BASE_URL="http://localhost:4000/api"

# Optional: what QR labels encode.
#   - By default (both unset), QRs encode `<origin>/s/<qrCodeValue>` so
#     an external camera opens the portal at the right page.
#   - Set VITE_QR_URL_PREFIX to a fixed host if labels are printed for a
#     deployed portal, e.g. "https://portal.upl.example/s".
#   - Set VITE_QR_PLAIN_PAYLOAD=true to encode only the raw value.
# VITE_QR_URL_PREFIX=""
# VITE_QR_PLAIN_PAYLOAD="false"
